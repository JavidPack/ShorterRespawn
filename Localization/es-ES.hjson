Mods: {
	ShorterRespawn: {
		DisableInstantRespawn: Desactivar reaparición instantánea
		EnableInstantRespawn: Activar reaparición instantánea

		Configs: {
			ShorterRespawnConfig: {
				DisplayName: Configuración de Shorter Respawn
				YouLackTheXPermission: Te falta el permiso "{0}".

				Headers: {
					Presets: Preajustes
					ConfigurableRespawnScales: Configuración de la escala de reaparición
					ResultingRespawnTimes: Tiempos de reaparición resultantes
					ExactSecondsAlternative: Alternativa de segundos exactos
					Tweaks: Ajustes
				}

				ShorterRespawnPreset: {
					Label: "[i:889] Preajuste de reaparición más corto"
					Tooltip:
						'''
						Este ajuste preestablecido reduce solo la penalización en [c/ec5353:modo experto].
						Esta opción está activa por defecto.
						'''
				}

				TerrariaDefaultsPreset: {
					Label: "[i:3099] Valores predeterminados de Terraria"
					Tooltip: El tiempo de reaparición, es el mismo que tiene Terraria de manera predeterminada.
				}

				GlobalRespawnScale: {
					Label: "[i:1175] Escala de reaparición global"
					Tooltip: ""
				}

				ExpertPenaltyScale: {
					Label: "[i:3233] Escala de penalización del modo experto"
					Tooltip:
						'''
						Penalización por tiempo de reaparición adicional en [c/ec5353:modo experto].
						El valor predeterminado de Terraria es 1,5.
						'''
				}

				BossPenaltyScale: {
					Label: "[i:43] Escala de penalizaciones del jefe"
					Tooltip:
						'''
						Penalización por tiempo de reaparición adicional por muertes durante peleas con jefes.
						El valor predeterminado de Terraria es 2.
						'''
				}

				DefaultRespawnTimeTooltip: El tiempo predeterminado de Terraria es {0} segundos
				NormalRespawn.Label: Tiempo de reaparición normal en segundos
				NormalBossRespawn.Label: Tiempo de reaparición contra un jefe, en normal. seg
				ExpertRespawn.Label: Tiempo de reaparición experto en segundos
				ExpertBossRespawn.Label: Tiempo de reaparición contra un jefe, en experto, seg

				UseSeconds: {
					Label: "[i:2703] Utilizar segundos exactos"
					Tooltip:
						'''
						Establezca los valores de tiempo de reaparición directamente en lugar de los controles deslizantes.
						Al habilitar esta opción se ignorarán los controles deslizantes y los ajustes preestablecidos.
						'''
				}

				NormalRespawnTime: {
					Label: "[i:2019] Tiempo de reaparición en modo normal"
					Tooltip:
						'''
						Establece el temporizador de reaparición en dificultad normal, en segundos.
						El tiempo predeterminado es {0} segundos.
						'''
				}

				ExpertRespawnTime: {
					Label: "[i:243] Tiempo de reaparición en modo experto"
					Tooltip:
						'''
						Establezca el temporizador de reaparición en [c/ec5353:modo experto], en segundos.
						El tiempo predeterminado es {0} segundos.
						'''
				}

				NormalBossRespawnTime: {
					Label: "[i: 2105] Tiempo de reaparición del jefe en normal"
					Tooltip:
						'''
						Establece el temporizador de reaparición en dificultad normal, en segundos, cuando un jefe está vivo.
						El tiempo predeterminado es {0} segundos.
						'''
				}

				ExpertBossRespawnTime: {
					Label: "[i:3335] Tiempo de reaparición del jefe en experto"
					Tooltip:
						'''
						Establece el temporizador de reaparición en [c/ec5353:modo experto], en segundos, cuando un jefe está vivo.
						El tiempo predeterminado es {0} segundos.
						'''
				}

				AdjustRespawnTimeWhenBossDespawns: {
					Label: "[i:WispinaBottle] Ajustar el tiempo de reaparición cuando el jefe queda solo"
					Tooltip:
						'''
						Si todos los jefes se van mientras estás muerto,
						El tiempo de reaparición se reducirá automáticamente al tiempo de reaparición del personaje que no es el jefe.
						'''
				}
			}
		}
	}
}

Mods: {
	ShorterRespawn: {
		DisableInstantRespawn: 禁用立刻复活
		EnableInstantRespawn: 启用立刻复活

		Configs: {
			ShorterRespawnConfig: {
				DisplayName: Shorter Respawn配置
				YouLackTheXPermission: 你没有"{0}"权限

				Headers: {
					Presets: 预设
					ConfigurableRespawnScales: 配置的复活时间倍率
					ResultingRespawnTimes: 结果复活时间
					ExactSecondsAlternative: 精确秒数设置
					Tweaks: 调整
				}

				ShorterRespawnPreset: {
					Label: "[i:889] Shorter Respawn预设"
					Tooltip: 此预设仅降低专家模式惩罚，并作为默认预设
				}

				TerrariaDefaultsPreset: {
					Label: "[i:3099] 原版默认预设"
					Tooltip: 此预设恢复原版的默认复活机制
				}

				GlobalRespawnScale: {
					Label: "[i:1175] 全局复活时间倍率"
					Tooltip: ""
				}

				ExpertPenaltyScale: {
					Label: "[i:3233] 专家模式惩罚倍率"
					Tooltip: 专家模式下额外的复活时间惩罚. 原版的默认值为1.5
				}

				BossPenaltyScale: {
					Label: "[i:43] Boss 惩罚倍率"
					Tooltip: Boss战期间死亡时额外的复活时间惩罚. 原版的默认值为 2。

				}

				DefaultRespawnTimeTooltip: 原版默认复活时间为 {0} 秒
				NormalRespawn.Label: 普通复活时间（秒）
				NormalBossRespawn.Label: 普通Boss战复活时间(秒)
				ExpertRespawn.Label: 专家模式复活时间（秒）
				ExpertBossRespawn.Label: 专家模式Boss战复活时间(秒)

				UseSeconds: {
					Label: "[i:2703] 使用精确秒数"
					Tooltip:
						'''
						直接设置复活时间，而不是使用滑块。
						启用后将忽略滑块和预设设置。
						'''
				}

				NormalRespawnTime: {
					Label: "[i:2019] 普通复活时间"
					Tooltip:
						'''
						设置普通情况下的复活时间，单位为秒。
						默认时间为 {0} 秒。
						'''
				}

				ExpertRespawnTime: {
					Label: "[i:243] 专家模式复活时间"
					Tooltip:
						'''
						设置专家模式下的复活时间，单位为秒。
						默认时间为 {0} 秒。
						'''
				}

				NormalBossRespawnTime: {
					Label: "[i:2105] 普通Boss战复活时间"
					Tooltip:
						'''
						设置 Boss 存活时的普通模式复活时间，单位为秒。
						默认时间为 {0} 秒。
						'''
				}

				ExpertBossRespawnTime: {
					Label: "[i:3335] 专家模式Boss战复活时间"
					Tooltip:
						'''
						设置 Boss 存活时的专家模式复活时间，单位为秒。
						默认时间为 {0} 秒。
						'''
				}

				AdjustRespawnTimeWhenBossDespawns: {
					Label: "[i:WispinaBottle] Boss离场时调整复活时间"
					Tooltip:
						'''
						如果你死亡时所有 Boss 都已离场，
						复活时间将自动降低至非Boss在场状态下的复活时间。
						'''
				}
			}
		}
	}
}

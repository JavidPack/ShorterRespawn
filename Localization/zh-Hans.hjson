				ExpertPenaltyScale: {
					// Label: "[i:3233] Expert Mode Penalty Scale"
					// Tooltip: Extra respawn time penalty while in Expert Mode. Default Terraria value is 1.5.
				}

				BossPenaltyScale: {
					// Label: "[i:43] Boss Penalty Scale"
